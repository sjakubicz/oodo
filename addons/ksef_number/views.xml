<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ksef" model="ir.ui.view">
        <field name="name">account.move.form.ksef</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="ksef_number" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="is_overdue" invisible="not is_overdue"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_ksef" model="ir.ui.view">
        <field name="name">account.move.list.ksef</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ksef_number" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
